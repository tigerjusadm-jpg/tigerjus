# =============================================
# TIGERJUS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha
# =============================================

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- OPENAI (IA Jurídica) ---
OPENAI_API_KEY=sk-...sua_chave_aqui

# --- ANTHROPIC (alternativa IA) ---
ANTHROPIC_API_KEY=sk-ant-...sua_chave_aqui

# --- MERCADO PAGO (pagamentos) ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...seu_token_aqui
MERCADOPAGO_PUBLIC_KEY=APP_USR-...sua_public_key
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret

# --- APP ---
NEXT_PUBLIC_APP_URL=https://tigerjus.com.br
NEXTAUTH_SECRET=gere_com_openssl_rand_base64_32
NEXTAUTH_URL=https://tigerjus.com.br

# --- POSTHOG (analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_...sua_chave
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- ONESIGNAL (push notifications) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID=seu_app_id
ONESIGNAL_REST_API_KEY=sua_rest_api_key
